# Agent Room P1 — environment template. NAMES ONLY — never commit real values.
# Copy to `.env` (gitignored) on the host that runs the services and fill it in
# there. Secrets stay on that host, never in the repo or in chat.
#
# SANDBOX FIRST: point every connection string at switchboard-sandbox. Never
# jessica-core without Austin's explicit go.

# --- Conductor (conductor/main.mjs) ---
# room_conductor via the session pooler (user room_conductor.<ref>, sslmode=require).
# NOINHERIT, conn-limit 5, 8s timeout; EXECUTE on the wrappers only, no table access.
CONDUCTOR_DATABASE_URL=

# The meeting the conductor drives and the read server shows.
MEETING_ID=

# Tick cadence in ms (optional; default 4000).
TICK_MS=4000

# --- Claude (builder) seat (conductor/main.mjs) ---
# Strong model id — this seat does the security-critical build/review reasoning.
# See the claude-api skill for the current strong model id; do not downgrade.
ROOM_CLAUDE_MODEL=
# Anthropic credential (ANTHROPIC_API_KEY, or an `ant auth login` profile / ANTHROPIC_AUTH_TOKEN).
ANTHROPIC_API_KEY=

# --- June / Harper seat routes (seats/june-route.mjs, seats/harper-route.mjs) ---
# Shared secret the conductor sends as x-room-token; the seat servers verify it.
ROOM_SEAT_TOKEN=
# The conductor reaches the seats at these URLs (seats bind localhost; front with TLS).
ROOM_JUNE_URL=
ROOM_HARPER_URL=
# Port each seat server listens on (optional; default in the route file).
# PORT=

# --- Read endpoint / room-view (room-view/server.mjs) ---
# room_reader via the session pooler (user room_reader.<ref>, sslmode=require).
# Read-only: EXECUTE on room_meeting_state + room_thread_read only, no writes.
ROOM_READER_DATABASE_URL=
# Port for the read server (optional; default 8787). Host same-origin with the page.
# PORT=8787
# THREAD_LIMIT=200
